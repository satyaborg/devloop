interactive_menu() {
  if [ "$#" -gt 0 ]; then
    printf '%s\n' "usage: devloop menu" >&2
    return 2
  fi

  local choice code
  while true; do
    UI_BACK=false
    ui_header "devloop" "Spec-driven code and review loop."
